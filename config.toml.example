# Transparent Agent Logger Configuration
# All settings are optional - defaults work out of the box

# Port to listen on (default: 12071)
port = 12071

# Directory for log files (default: ./logs)
# sessions.db is stored inside this directory
log_dir = "./logs"

# Request-log pruning (PRI-3457): runs at startup and then hourly, but only
# if one of the two settings below is non-zero. Default is 0/0 - fully
# disabled, no deletion of any kind - because pruning only matters for a
# long-lived sidecar against a persistent data disk, which isn't every
# install of this binary. sen-core's docker-compose sets both (14 days /
# 5 GiB) for colleague boxes; uncomment and adjust here for any other
# deployment that wants the same protection.

# Delete files under log_dir older than this many days (mtime-based).
# 0 (the default) disables age-based pruning entirely.
# log_retention_days = 14

# Total-size cap in bytes for log_dir; once over, the oldest files are
# deleted first until back under the cap. 0 (the default) disables the
# size cap entirely. Either setting works alone - e.g. age pruning with no
# cap, or a cap with no age limit.
# log_max_bytes = 5368709120

listen_host = "localhost"   # bind address; defaults to "localhost" (loopback-only)
                            # SECURITY: this proxy has no authentication of its own.
                            # Binding to any non-loopback address (e.g. a container bridge IP or 0.0.0.0)
                            # exposes it to every process that can reach that interface.
                            # Only do so when the interface is protected by a host firewall rule or
                            # an isolated network bridge that prevents untrusted access.

# Claude Platform on AWS signing (all empty by default). Mode "platform"
# requires region and workspace ID. The optional role is assumed for signing
# with automatically renewed credentials and sessions limited to one hour.
# A role failure fails the request without signing with default-chain credentials.
anthropic_aws_mode = ""
anthropic_aws_region = ""
anthropic_aws_workspace_id = ""
anthropic_aws_role_arn = ""

# Loki log export configuration
# Pushes logs to Grafana Loki for centralized observability
[loki]
# Enable Loki export (default: false)
enabled = false

# Full Loki push endpoint URL (required when enabled)
# Example: http://loki.example.com:3100/loki/api/v1/push
url = ""

# Bearer token for authentication (optional)
auth_token = ""

# Number of entries to batch before sending (default: 1000)
batch_size = 1000

# Maximum time to wait before sending a partial batch (default: "5s")
batch_wait = "5s"

# Maximum retry attempts for failed pushes (default: 5)
retry_max = 5

# Enable gzip compression for requests (default: true)
use_gzip = true

# Environment label for Loki (default: "development")
# Used as a label in Loki queries (e.g., development, staging, production)
environment = "development"

[api_token_substitution]
enabled = false
command = ""          # local command: JSON context on stdin, real key on stdout (exit 0)
cache_ttl = "5m"
cache_size = 10000
timeout = "2s"
